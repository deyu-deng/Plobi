{
  "name": "plobi-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "workspaces": [
    "apps/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web"
  ],
  "scripts": {
    "postinstall": "echo '✅ Browser tools ready. Run: python run_agent.py --help'",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace ui-tui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyu-deng/Plobi.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/deyu-deng/Plobi/issues"
  },
  "homepage": "https://github.com/deyu-deng/Plobi#readme",
  "dependencies": {
    "@streamdown/math": "^1.0.4",
    "agent-browser": "^0.43.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "overrides": {
    "@univerjs/core": {
      ".": "0.25.1",
      "nanoid": "6.0.2"
    },
    "@univerjs/themes": "0.25.1",
    "@bitclub.ai/opendesk-office": {
      "esbuild": "0.28.2",
      "pdfjs-dist": "6.5.438"
    },
    "electron": "43.8.13",
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "browserslist": "4.28.7",
    "colord": "2.14.0",
    "concurrently": "10.0.6",
    "fast-uri": "3.1.9",
    "fast-xml-parser": "5.12.1",
    "follow-redirects": "1.16.2",
    "glob@^13.0.0": "14.0.6",
    "joi": "18.3.1",
    "js-yaml": "4.3.2",
    "katex": "0.19.1",
    "minimatch@^9.0.0": "11.0.9",
    "minimatch@^10.0.0": "11.0.9",
    "postcss-selector-parser": "7.2.1",
    "sanitize-html": "2.18.2",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "tar": "7.5.21",
    "undici@^6.0.0": "6.29.1",
    "undici@^7.0.0": "7.30.2",
    "vite": "8.3.3",
    "zod": "4.6.7",
    "@napi-rs/canvas": "1.2.1",
    "fast-xml-builder": "1.3.2",
    "is-unsafe": "2.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
