.cursor/
.gemini/
.zed/
.mcp.json
opencode.json
config/mcporter.json

plobi_cli/tui_dist/*
plobi_cli/scripts/
docs/superpowers/*
# Working directory for the Plobi Agent's session state (~/.plobi/ at runtime;
# also created in-repo when an agent operates in this checkout). Plans, audit
# logs, and per-session caches are never artifacts of the codebase.
.plobi/

# Desktop/bootstrap install marker written into the managed checkout root by the
# bootstrap installer. It is Plobi-managed runtime state, never a code change —
# ignore it so `plobi update`'s `git stash push --include-untracked` does not
# treat it as a local edit and autostash it on every run (#38529).
.plobi-bootstrap-complete

# Persistent dev sandbox dir (scripts/dev-sandbox.sh --persistent)
.plobi-sandbox/

# Interrupted-update breadcrumb + recovery lock written next to the shared venv
# by `plobi update` / launch-time self-heal. Runtime state, never a code change
# — ignore so `git status` stays clean and update's autostash skips them.
.update-incomplete
.update-incomplete.lock

# Tool Search live-test harness output — non-deterministic model transcripts,
# regenerated by scripts/tool_search_livetest.py. Never an artifact of the repo.
scripts/out/

# Per-release changelog drafts. These exist only transiently during a release
# cut (passed to `gh release create --notes-file`); the GitHub Release itself
# stores the published notes. They are not a build artifact and must never be
# committed to the repo root. See the plobi-release skill.
RELEASE_v*.md

# Desktop demo-run scratch output (plobi writes demo/*.txt during recorded
# walkthroughs). Throwaway artifacts, never part of the app.
apps/desktop/demo/

# PR infographics are rendered locally and embedded in PR descriptions via the
# image-provider (fal.media) URL — they are NEVER committed to the repo. The
# PR body is the archive. See the plobi-agent-dev skill's
# pr-infographic-workflow reference (storage rule + lapse #8 / #COMMIT-1).
infographic/

# Plobi agent working memory (private, machine-specific — NOT project source)
.workbuddy/

# Old Plobi code backup. Carries its own .git history on disk (preserved as a
# restore point); excluding from the main repo avoids a nested-repository commit.
backup/

# Desktop compiled JS artifacts (bare tsc output next to .ts/.tsx sources; keep out of git)
apps/desktop/src/**/*.js

# nested Mind repo (independent git, never commit into Code)
/mind/

# Leaked Windows env-var literal directory (never commit system caches)
%SystemDrive%/

.pytest-tmp*/
.pytest-b5-run/
.pytest-run-bugfix/
.pytest-run/
.pytest-*/
db_storage/
# leaked agent-workspace paths (never source) —— 通用写法，不把本机用户名写进仓库
C*Users*AppData*
DataDefault.doubaoagent_mode*

## WP-P0-HYGIENE-2: session-scoped test/agent artifacts
# Root-level log dumps written by `pytest ... --basetemp=<file.log>` /
# debug captures across WP runs. Per-session, never source.
.day-*.log
.dayreg.log
.dtdigest-*.log
.meals-*.log
.pytest-*.log
.secv-*.log
.secv-*.json
.p0hyg-*.txt
# 警告：仓库根**绝不**允许出现名为 HEAD 的文件（真实 HEAD 只在 .git/HEAD）。
# 2026-09-07 修复事故时曾误建一个，它让每条 `git … HEAD`（含每日 bundle 任务）
# 报 "ambiguous argument: both revision and filename"，而且当时这里有一条 `/HEAD`
# 忽略规则把它藏了两周，git status 完全看不见。规则已删；再遇到直接删文件，
# 不要重新加忽略。
# Electron dev-server scratch log (npm run dev). Lives in apps/desktop/ but
# is build/runtime output, not source.
/apps/desktop/desktop_dev.log

# WP-ENV-REBASELINE: agent/pytest root dumps (never source)
.md-*.log
.mind-*.log
.morn-*.log
.pp-*.log
