import remarkParse from 'remark-parse'
import remarkRehype from 'remark-rehype'
import { remarkWikilink } from '../apps/desktop/src/app/knowledge/remark-wikilink'

const src = '看 [[Creo]] 这个'
const tree = remarkParse()(src as never)
console.log('=== mdast (parse 后) ===')
console.log(JSON.stringify(tree, (k, v) => (k === 'position' ? undefined : v), 1).slice(0, 800))

const withPlugin = remarkWikilink()(tree as never)
console.log('\n=== mdast (插件后) ===')
console.log(JSON.stringify(withPlugin, (k, v) => (k === 'position' ? undefined : v), 1).slice(0, 1400))

const hast = remarkRehype()(withPlugin as never)
console.log('\n=== hast ===')
console.log(JSON.stringify(hast, (k, v) => (k === 'position' ? undefined : v), 1).slice(0, 1100))
